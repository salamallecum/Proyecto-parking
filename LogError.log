     facturas.`Efectivo` AS facturas_Efectivo,
     facturas.`Cambio` AS facturas_Cambio
FROM
     `usuarios` usuarios INNER JOIN `facturas` facturas ON usuarios.`Id_usuario` = facturas.`Facturado_por`
WHERE 1=1
