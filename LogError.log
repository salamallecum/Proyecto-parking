     usuarios.`Id_usuario` AS usuarios_Id_usuario,
     usuarios.`Usuario` AS usuarios_Usuario,
     facturas.`Codigo` AS facturas_Codigo,
     facturas.`Fecha_factura` AS facturas_Fecha_factura,
